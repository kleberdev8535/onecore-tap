# OneCore Tap - variaveis de ambiente
# Copie para .env (nunca versionado) e ajuste. Nenhum segredo vai para o frontend.

# ---------- Banco de dados (backend) ----------
DB_URL=jdbc:postgresql://localhost:5432/onecore_tap
DB_USERNAME=onecore
DB_PASSWORD=troque-esta-senha
DB_POOL_SIZE=10

# ---------- Primeiro Super Admin ----------
# Usado somente quando ainda nao existe nenhum Super Admin. Senha com 12+ caracteres.
# Depois do primeiro boot, remova estas variaveis do ambiente.
SUPERADMIN_EMAIL=admin@onecorebusiness.com.br
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=OneCore Business

# ---------- URLs e CORS ----------
# URL publica do frontend (usada nos links de redefinicao de senha)
APP_URL=http://localhost:5173
# Origens permitidas (separadas por virgula). Em producao com rewrite da Vercel, use o dominio do app.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Sessao ----------
# true em producao (HTTPS). Marca os cookies de sessao e CSRF como Secure.
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=12h

# ---------- Documentacao da API ----------
# Desative em producao se nao quiser expor o Swagger publicamente.
API_DOCS_ENABLED=true

# ---------- E-mail ----------
# Nenhum provedor configurado ainda. true = escreve o conteudo dos e-mails (incluindo links) no log.
# NUNCA use true em producao.
MAIL_LOG_CONTENT=false

# ---------- Frontend (desenvolvimento) ----------
# Destino do proxy /api do Vite.
VITE_DEV_API_TARGET=http://localhost:8080
PLATE_PUBLIC_BASE_URL=https://tap.onecorebusiness.com.br/t/
